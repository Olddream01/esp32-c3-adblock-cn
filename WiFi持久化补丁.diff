+// The SSID lives in NVS ("wifi" namespace), and a second copy is kept in
+// LittleFS (/wifi.cfg). NVS is the first thing to die when the flash gets
+// erased or a sector goes bad -- and "my network disappeared again" is
+// exactly the complaint this guards against. On boot, if NVS is empty but
+// the backup is there, the backup wins and is written back into NVS.
+#define WIFI_BACKUP_PATH "/wifi.cfg"
+
+static void saveWifiCreds(const String& ssid, const String& pass) {
+  prefs.begin("wifi", false);
+  prefs.putString("ssid", ssid);
+  prefs.putString("pass", pass);
+  prefs.end();
+
+  prefs.begin("wifi", true);
+  String back = prefs.getString("ssid", "");
+  prefs.end();
+  if (back != ssid) Serial.println("[wifi] WARN: NVS readback mismatch");
+
+  File f = LittleFS.open(WIFI_BACKUP_PATH, "wb");
+  if (!f) { Serial.println("[wifi] WARN: LittleFS backup open failed"); return; }
+  uint16_t n = ssid.length();
+  f.write((uint8_t)(n & 0xFF)); f.write((uint8_t)(n >> 8));
+  f.write((uint8_t*)ssid.c_str(), n);
+  n = pass.length();
+  f.write((uint8_t)(n & 0xFF)); f.write((uint8_t)(n >> 8));
+  f.write((uint8_t*)pass.c_str(), n);
+  f.close();
+  Serial.println("[wifi] creds saved (NVS + LittleFS backup)");
+}
+
+static bool loadWifiCreds(String& ssid, String& pass) {
+  prefs.begin("wifi", true);
+  ssid = prefs.getString("ssid", "");
+  pass = prefs.getString("pass", "");
+  prefs.end();
+  if (ssid.length()) return true;
+
+  File f = LittleFS.open(WIFI_BACKUP_PATH, "rb");
+  if (!f) return false;
+  uint8_t lenb[2]; uint16_t n; bool ok = false;
+  if (f.read(lenb, 2)) {
+    n = lenb[0] | (lenb[1] << 8);
+    String s; s.reserve(n);
+    for (uint16_t i = 0; i < n; i++) { int c = f.read(); if (c < 0) break; s += (char)c; }
+    if (f.read(lenb, 2)) {
+      n = lenb[0] | (lenb[1] << 8);
+      String p; p.reserve(n);
+      for (uint16_t i = 0; i < n; i++) { int c = f.read(); if (c < 0) break; p += (char)c; }
+      if (s.length()) {
+        ssid = s; pass = p; ok = true;
+        Serial.printf("[wifi] restored creds from LittleFS backup: %s\n", ssid.c_str());
+      }
+    }
+  }
+  f.close();                                  // close before healing NVS: saveWifiCreds
+  if (ok) saveWifiCreds(ssid, pass);         // rewrites the same file
+  return ok;
+}
