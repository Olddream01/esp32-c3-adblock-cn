+    Serial.printf("WiFi: connecting to \"%s\"%s (attempt %d/3)\n", ssid,
+                  ss.length() ? " (provisioned)" : " (secrets.h)", attempt);
+    WiFi.begin(ssid, pass);
+    uint32_t t0 = millis();
+    while (WiFi.status() != WL_CONNECTED && millis() - t0 < 20000) { delay(250); Serial.print("."); }
+    Serial.println();
+    if (WiFi.status() == WL_CONNECTED) return true;
+    WiFi.disconnect(true); delay(800);
+  }
+  return false;
